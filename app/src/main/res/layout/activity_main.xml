            android:text="1h"
            android:textColor="@color/systemGray"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/socialMixingScoreUnitM30"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:gravity="center"
            android:onClick="onClickSocialMixingScoreUnit"
            android:text="30m"
            android:textColor="@color/systemGray"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/socialMixingScoreUnitM15"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:gravity="center"
            android:onClick="onClickSocialMixingScoreUnit"
            android:text="15m"
            android:textColor="@color/systemGray"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/socialMixingScoreUnitM5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:gravity="center"
            android:onClick="onClickSocialMixingScoreUnit"
            android:text="5m"
            android:textColor="@color/systemGray"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/socialMixingScoreUnitM1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:gravity="center"
            android:onClick="onClickSocialMixingScoreUnit"
            android:text="1m"
            android:textColor="@color/systemBlue"
            android:textSize="15sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/detection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@color/systemGray6"
        android:paddingHorizontal="10dp"
        android:paddingVertical="5dp"
        android:text="DETECTION (0)"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/socialMixingScoreUnit" />

    <ListView
        android:id="@+id/targets"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/detection" />

    <LinearLayout
        android:id="@+id/temporalHistogramUnit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="5dp"
        android:background="@color/systemGray6"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@id/temporalHistogram"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">

        <TextView
            android:id="@+id/temporalHistogramUnitD7"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:gravity="center"
            android:onClick="onClickTemporalHistoryUnit"
            android:text="7d"
            android:textColor="@color/systemGray"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/temporalHistogramUnitD2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:gravity="center"
            android:onClick="onClickTemporalHistoryUnit"
            android:text="2d"
            android:textColor="@color/systemGray"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/temporalHistogramUnitD1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:gravity="center"
